#!/usr/bin/env bash
# Send contract (knowledge/README.md): body on stdin, subject in VAHTOVIK_SUBJECT, exit 0 when delivered.
set -euo pipefail

path="${FILE_CHANNEL_PATH:-${VAHTOVIK_HOME:-.}/data/outbox.md}"
body="$(cat)"
if [[ -n "${VAHTOVIK_REPLY_TO:-}" ]]; then
    from="reply to message ${VAHTOVIK_REPLY_TO}"
elif [[ -n "${VAHTOVIK_WORKER_NAME:-}" ]]; then
    from="worker ${VAHTOVIK_WORKER_NAME}"
else
    from="vahtovik"  # vahtovik's own message, such as a notice or a usage warning
fi
block="## $(date '+%Y-%m-%d %H:%M') · ${VAHTOVIK_SUBJECT:-report}
_${from}_

${body}
"

if [[ "${VAHTOVIK_DRY_RUN:-}" == "1" ]]; then
    printf 'dry run, would append to %s:\n%s\n' "$path" "$block" >&2
    echo "dry-run"
    exit 0
fi

mkdir -p "$(dirname "$path")"
printf '%s\n' "$block" >> "$path"
echo "$path:$(wc -l < "$path")"
