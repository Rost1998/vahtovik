# Copy to .env and fill in. vahtovik loads .env at startup; values already set in the environment win.
# Secrets of one watch only, such as source tokens, go to watches/<name>/.env in the same format.

# Telegram channel skill
# TELEGRAM_BOT_TOKEN=123456:ABC-your-bot-token

# Only for `claude.auth: api-key` in vahtovik.yaml
# ANTHROPIC_API_KEY=sk-ant-...
