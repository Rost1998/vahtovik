{
  "type": "object",
  "additionalProperties": false,
  "required": ["summary", "importance", "reports", "not_reported"],
  "properties": {
    "summary": {"type": "string"},
    "importance": {"type": "string", "enum": ["low", "medium", "high", "critical"]},
    "reports": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["channel", "delivery_id"],
        "properties": {
          "channel": {"type": "string"},
          "delivery_id": {"type": "integer"}
        }
      }
    },
    "not_reported": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["channel", "reason"],
        "properties": {
          "channel": {"type": "string"},
          "reason": {"type": "string"}
        }
      }
    }
  }
}
