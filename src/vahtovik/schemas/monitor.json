{
  "type": "object",
  "additionalProperties": false,
  "required": ["artifacts", "notes"],
  "properties": {
    "artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "title", "url", "summary", "role", "worker", "worker_title"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "title": {"type": "string"},
          "url": {"type": "string"},
          "summary": {"type": "string"},
          "details": {"type": "string"},
          "role": {"type": "string", "minLength": 1, "description": "The role of the worker that gets it"},
          "worker": {"type": "string", "minLength": 1, "description": "The key of the worker that gets it, within its role"},
          "worker_title": {"type": "string", "description": "The title of the worker, if it is new"}
        }
      }
    },
    "notes": {"type": "string"}
  }
}
