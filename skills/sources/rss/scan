#!/usr/bin/env python3
"""Scan contract (skills/README.md): print the feed's new entries as `items`, for `scan: script` sources."""

import json
import os
import subprocess
import sys
from pathlib import Path

params = json.loads(os.environ.get("VAHTOVIK_PARAMS") or "{}")
command = [sys.executable, str(Path(__file__).resolve().with_name("scripts") / "fetch.py"),
           "--url", str(params.get("url", "")), "--state-dir", os.environ["VAHTOVIK_STATE_DIR"]]
if params.get("max"):
    command += ["--max", str(params["max"])]
proc = subprocess.run(command, capture_output=True, text=True)
if proc.returncode != 0:
    sys.stderr.write(proc.stderr)
    sys.exit(proc.returncode)
data = json.loads(proc.stdout)
print(json.dumps({"items": data["new"], "error": data["error"]}, ensure_ascii=False))
