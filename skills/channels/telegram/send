#!/usr/bin/env bash
# Channel contract: body on stdin, subject in VAHTOVIK_SUBJECT, exit 0 when delivered.
set -euo pipefail
shopt -u patsub_replacement 2>/dev/null || true  # bash 5.2+: keep "&" in ${var//x/y} replacements literal

: "${TELEGRAM_BOT_TOKEN:?TELEGRAM_BOT_TOKEN is not set}"
: "${TELEGRAM_CHAT_ID:?TELEGRAM_CHAT_ID is not set}"

body="$(cat)"
if [[ "${VAHTOVIK_PLAIN:-}" == "1" ]]; then  # plain text from vahtovik: escape it for HTML
    body="${body//&/&amp;}"; body="${body//</&lt;}"; body="${body//>/&gt;}"
fi
subject="${VAHTOVIK_SUBJECT:-}"
subject="${subject//&/&amp;}"; subject="${subject//</&lt;}"; subject="${subject//>/&gt;}"
text="${subject:+<b>${subject}</b>
}${body}"

if [[ "${VAHTOVIK_DRY_RUN:-}" == "1" ]]; then
    printf 'dry run, would send to chat %s%s:\n%s\n' "$TELEGRAM_CHAT_ID" \
        "${VAHTOVIK_REPLY_TO:+ in reply to message $VAHTOVIK_REPLY_TO}" "$text" >&2
    echo "dry-run"
    exit 0
fi

reply=()
if [[ "${VAHTOVIK_REPLY_TO:-}" =~ ^[0-9]+$ ]]; then  # an answer to the person's message, read by `receive`
    reply=(--data-urlencode "reply_parameters={\"message_id\":${VAHTOVIK_REPLY_TO},\"allow_sending_without_reply\":true}")
fi

response="$(curl -sS --max-time 30 -X POST "${TELEGRAM_API_URL:-https://api.telegram.org}/bot${TELEGRAM_BOT_TOKEN}/sendMessage" \
    --data-urlencode "chat_id=${TELEGRAM_CHAT_ID}" \
    --data-urlencode "text=${text}" \
    --data-urlencode "parse_mode=HTML" \
    --data-urlencode "disable_web_page_preview=true" \
    ${reply[@]+"${reply[@]}"})"

if [[ "$response" == *'"ok":true'* ]]; then
    id="$(grep -o '"message_id":[0-9]*' <<<"$response" | head -1 | cut -d: -f2)"
    echo "message ${id:-?}"
else
    echo "$response" >&2
    exit 1
fi
