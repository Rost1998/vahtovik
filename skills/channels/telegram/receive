#!/usr/bin/env python3
"""Channel input contract (skills/README.md): print the new text messages of the chat TELEGRAM_CHAT_ID,
read with the bot's getUpdates. Standard library only."""

import json
import os
import sys
import urllib.error
import urllib.parse
import urllib.request
from datetime import datetime, timezone
from pathlib import Path


def fail(error: str) -> int:
    print(json.dumps({"messages": [], "error": error}))
    return 0


def main() -> int:
    token, chat = os.environ.get("TELEGRAM_BOT_TOKEN"), os.environ.get("TELEGRAM_CHAT_ID")
    if not token or not chat:
        return fail("TELEGRAM_BOT_TOKEN and TELEGRAM_CHAT_ID must be set")
    state = Path(os.environ["VAHTOVIK_STATE_DIR"])
    state.mkdir(parents=True, exist_ok=True)
    marker = state / "offset"
    offset = int(marker.read_text()) if marker.exists() else 0
    # Telegram drops the updates before `offset` only at the next call, so a state folder that vahtovik puts back
    # reads them again.
    query = urllib.parse.urlencode({"offset": offset, "timeout": 0, "allowed_updates": json.dumps(["message"])})
    api = os.environ.get("TELEGRAM_API_URL") or "https://api.telegram.org"
    try:
        with urllib.request.urlopen(f"{api}/bot{token}/getUpdates?{query}", timeout=30) as response:
            data = json.loads(response.read())
    except urllib.error.HTTPError as exc:  # its text never holds the URL, which holds the token
        try:
            detail = json.loads(exc.read()).get("description")
        except ValueError:
            detail = None
        return fail(f"getUpdates: HTTP {exc.code}: {detail or exc.reason}")
    except (urllib.error.URLError, OSError, ValueError) as exc:
        return fail(f"getUpdates: {type(exc).__name__}: {getattr(exc, 'reason', exc)}")
    if not data.get("ok"):
        return fail(f"getUpdates: {data.get('description') or 'not ok'}")
    messages = []
    for update in data.get("result") or []:
        offset = max(offset, update["update_id"] + 1)
        message = update.get("message") or {}
        text = message.get("text") or message.get("caption")
        if str((message.get("chat") or {}).get("id")) != chat or not text:
            continue  # only the person's chat, and only text
        sender = message.get("from") or {}
        messages.append({
            "id": str(message["message_id"]),
            "text": text,
            # a stable id, for the channel's `senders`: anybody can take a display name
            "from": f"@{sender['username']}" if sender.get("username") else f"id:{sender.get('id', 'unknown')}",
            "time": datetime.fromtimestamp(message.get("date", 0), timezone.utc).isoformat(timespec="seconds"),
        })
    marker.write_text(str(offset))
    print(json.dumps({"messages": messages, "error": None}, ensure_ascii=False))
    return 0


if __name__ == "__main__":
    sys.exit(main())
